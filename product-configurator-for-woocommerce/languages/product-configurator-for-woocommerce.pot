msgid "Control overall brightness, alpha output and quality effects. Higher quality can be more demanding on performance."
msgstr ""

#: src/inc/admin/views/3d-settings-sections/renderer-output.php:8
msgid "Tone mapping"
msgstr ""

#: src/inc/admin/views/3d-settings-sections/renderer-output.php:10
