msgstr ""

#: src/inc/admin/views/3d-settings-sections/renderer-output.php:10
msgid "Filmic (ACES) — recommended"
msgstr ""

#: src/inc/admin/views/3d-settings-sections/renderer-output.php:11
msgid "Brightness is multiplied and then clipped. Bright areas turn flat white with no detail."
msgstr ""

#: src/inc/admin/views/3d-settings-sections/renderer-output.php:11
msgid "Linear"
msgstr ""

#: src/inc/admin/views/3d-settings-sections/renderer-output.php:12
